// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model QuantityBreak {
  id        String              @id @default(cuid())
  shop      String
  title     String
  status    String              @default("active")
  products  Json
  tiers     QuantityBreakTier[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([shop])
}

model QuantityBreakTier {
  id              String         @id @default(cuid())
  quantityBreakId String
  quantityBreak   QuantityBreak  @relation(fields: [quantityBreakId], references: [id], onDelete: Cascade)
  minQuantity     Int
  discountType    String
  discountValue   Float

  @@index([quantityBreakId])
}

model Bundle {
  id                String   @id @default(cuid())
  shop              String
  title             String
  description       String   @default("")
  status            String   @default("active")
  discountType      String   @default("percentage")
  discountValue     Float    @default(0)
  shopifyDiscountId String?
  items             Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shop])
}

model Discount {
  id                String    @id @default(cuid())
  shop              String
  title             String
  type              String
  status            String    @default("active")
  shopifyDiscountId String?
  products          Json?
  details           Json?
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([shop])
}
