<div
  class="pummpy-bundle-showcase"
  data-pummpy-bundle-showcase
  data-pummpy-heading="{{ section.settings.heading }}"
>
  <div class="pummpy-offers__loading">Loading offers&hellip;</div>
</div>

<link rel="stylesheet" href="{{ 'pummpy-offers.css' | asset_url }}">
<script src="{{ 'pummpy-offers.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Pummpy Bundle Showcase",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Combo packages"
    }
  ]
}
{% endschema %}
