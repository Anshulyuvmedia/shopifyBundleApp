<div
  class="pummpy-offers"
  data-pummpy-product-id="{{ product.id }}"
  data-pummpy-variant-ids="{% for variant in product.variants %}{{ variant.id }}{% unless forloop.last %},{% endunless %}{% endfor %}"
  data-pummpy-after-buy="{{ section.settings.after_buy_button }}"
>
  <div class="pummpy-offers__loading">Loading offers&hellip;</div>
</div>

<link rel="stylesheet" href="{{ 'pummpy-offers.css' | asset_url }}">
<script src="{{ 'pummpy-offers.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Bundle Product Offers",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "after_buy_button",
      "label": "Place below the Buy it now button",
      "default": false
    }
  ]
}
{% endschema %}
